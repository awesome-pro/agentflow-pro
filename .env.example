# Copy this to .env and fill in the values you have.
# Ollama runs locally — no key needed for the core loop.

# Web search tool — free tier is 1,000 searches/month: https://tavily.com
TAVILY_API_KEY=

# Hugging Face gated datasets such as GPQA Diamond. Create a read token at:
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: cheap GPT-4o alternative for benchmarking
DEEPSEEK_API_KEY=

# Optional: judge model for final evaluation
OPENAI_API_KEY=

# Optional: training run logs (free for individuals)
WANDB_API_KEY=
